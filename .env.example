# Postgres connection string. On Vercel this comes from the Neon Marketplace integration.
DATABASE_URL=

# Bearer token for /api/admin/*. Generate a long random string. Never commit the real value.
ADMIN_TOKEN=

# Resend (https://resend.com). Leave blank until you are ready; the site still runs.
RESEND_API_KEY=

# Resend segment id (segments replaced audiences). Example: seg_...
# The env name stays RESEND_AUDIENCE_ID so existing setup notes still match.
RESEND_AUDIENCE_ID=

# From address for the newsletter and owner alerts.
# Leave unset, or use a placeholder, until a domain is verified in Resend.
# Example once verified: American Capitol Watch <news@example.com>
NEWSLETTER_FROM=

# Optional postal address printed in the newsletter draft (CAN-SPAM). Do not invent one.
NEWSLETTER_POSTAL_ADDRESS=

# Where sponsor inquiries are emailed.
OWNER_EMAIL=

# Public site origin, no trailing slash. Used for links, sitemap, and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
